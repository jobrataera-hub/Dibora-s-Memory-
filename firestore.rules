rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.admin == true;}
  match /memories/{id}{
   allow read: if resource.data.published == true || isAdmin();
   allow create,update,delete: if isAdmin();
  }
  match /wishes/{id}{
   allow read: if resource.data.approved == true || isAdmin();
   allow create: if request.auth != null
     && request.resource.data.keys().hasOnly(['name','text','approved','authorUid','createdAt'])
     && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
     && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
     && request.resource.data.approved == false && request.resource.data.authorUid == request.auth.uid;
   allow update,delete: if isAdmin();
  }
  match /{document=**}{allow read,write: if false;}
 }
}